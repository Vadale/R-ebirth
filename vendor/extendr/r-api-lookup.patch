+/// Look up a binding while containing R errors before returning to Rust callers.
+///
+/// `Ok(None)` means absent; a present R NULL is `Ok(Some(R_NilValue))`.
+/// On older R, retain findVar's promise semantics. R >= 4.5 uses R_getVarEx.
+///
+/// # Safety
+/// The caller must run on R's thread with a valid symbol and environment, both
+/// rooted for the call, and protect a returned SEXP before any allocation.
+/// The R callback deliberately owns only plain pointers/scalars: an R longjmp
+/// must not cross Rust values with destructors or a Rust error/panic boundary.
+pub unsafe fn try_get_var(symbol: SEXP, env: SEXP, inherits: bool) -> Result<Option<SEXP>, ()> {
+    use std::ffi::c_void;
+    extern "C" {
+        fn R_ToplevelExec(
+            fun: Option<unsafe extern "C" fn(*mut c_void)>,
+            data: *mut c_void,
+        ) -> Rboolean;
+    }
+    struct Lookup {
+        symbol: SEXP,
+        env: SEXP,
+        inherits: bool,
+        value: Option<SEXP>,
+    }
+    unsafe extern "C" fn lookup(data: *mut c_void) {
+        let data = &mut *data.cast::<Lookup>();
+        #[cfg(r_4_5)]
+        {
+            // Fresh protected identity cannot collide with NULL or any binding.
+            let absent = crate::Rf_protect(crate::Rf_cons(crate::R_NilValue, crate::R_NilValue));
+            let value = R_getVarEx(data.symbol, data.env, data.inherits.into(), absent);
+            data.value = if value == absent { None } else { Some(value) };
+            crate::Rf_unprotect(1);
+        }
+        #[cfg(not(r_4_5))]
+        {
+            let value = if data.inherits {
+                Rf_findVar(data.symbol, data.env)
+            } else {
+                Rf_findVarInFrame(data.env, data.symbol)
+            };
+            data.value = if value == R_UnboundValue {
+                None
+            } else {
+                Some(value)
+            };
+        }
+    }
+    let mut data = Lookup {
+        symbol,
+        env,
+        inherits,
+        value: None,
+    };
+    // R_ToplevelExec restores R's protection stack on both completion and error;
+    // no Rust owner or lock guard is created inside its callback.
+    if R_ToplevelExec(Some(lookup), (&mut data as *mut Lookup).cast()) == Rboolean::TRUE {
+        Ok(data.value)
+    } else {
+        Err(())
     }
